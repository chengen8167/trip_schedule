root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.html]
indent_size = 4

[*.css]
indent_size = 4

[*.js]
indent_size = 4

[*.cs]
indent_style = space
indent_size = 4

# 其他規則可視專案需求再擴充